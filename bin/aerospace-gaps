#!/usr/bin/env bash
# aerospace-gaps — switch AeroSpace's outer.top gap between docked and native layouts.
# https://github.com/phasewalk1/aerospace-gaps
#
# Usage:
#   aerospace-gaps            auto-detect from attached monitors
#   aerospace-gaps docked     force the external-display value
#   aerospace-gaps native     force the built-in-display value
#   aerospace-gaps toggle     flip to the other value
#   aerospace-gaps status     print current/detected values, change nothing
#   aerospace-gaps --version  print the version
#
# Configuration, in order of precedence:
#   environment > directives in aerospace.toml > config file > defaults
#
# Directives are comments in your aerospace.toml, one per line, anywhere in
# the file, so your settings live alongside the gaps they describe:
#
#   # aerospace-gaps: docked  = 40
#   # aerospace-gaps: native  = 10
#   # aerospace-gaps: monitor = ultragear|dell u2720q
#   # aerospace-gaps: key     = outer.top
#
# Config file: ${XDG_CONFIG_HOME:-~/.config}/aerospace-gaps/config (shell syntax)
#
#   AEROSPACE_CONFIG          path to aerospace.toml
#   AEROSPACE_GAP_DOCKED      the gap value when an external display is attached
#   AEROSPACE_GAP_NATIVE      the gap value when it is not
#   AEROSPACE_DOCKED_MONITOR  case-insensitive regex matched against monitor names
#   AEROSPACE_GAP_KEY         the gap key to rewrite (default: outer.top)

set -euo pipefail

VERSION=1.1.0

# Remember which values came from the environment; they outrank every file.
ENV_DOCKED="${AEROSPACE_GAP_DOCKED:-}"
ENV_NATIVE="${AEROSPACE_GAP_NATIVE:-}"
ENV_MONITOR="${AEROSPACE_DOCKED_MONITOR:-}"
ENV_KEY="${AEROSPACE_GAP_KEY:-}"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
RC="$XDG_CONFIG_HOME/aerospace-gaps/config"
if [[ -f $RC ]]; then
  # shellcheck source=/dev/null
  . "$RC"
fi

CONFIG="${AEROSPACE_CONFIG:-$XDG_CONFIG_HOME/aerospace/aerospace.toml}"
DOCKED_TOP="${AEROSPACE_GAP_DOCKED:-40}"
NATIVE_TOP="${AEROSPACE_GAP_NATIVE:-10}"
DOCKED_MONITOR="${AEROSPACE_DOCKED_MONITOR:-}"
GAP_KEY="${AEROSPACE_GAP_KEY:-outer.top}"

# Monitor names AeroSpace reports for Apple's own panels. Anything else is external.
BUILTIN_MONITOR='built-?in|color lcd|liquid retina|sidecar'

# Directive names found in aerospace.toml, for `status` to report.
FROM_TOML=

die() { printf 'aerospace-gaps: %s\n' "$*" >&2; exit 1; }

# Read a `# aerospace-gaps: <name> = <value>` directive from the AeroSpace
# config. The value is the rest of the line, trimmed, so regexes may contain
# spaces and pipes. The first occurrence wins.
directive() {
  [[ -f $CONFIG ]] || return 0
  sed -n "s/^[[:space:]]*#[[:space:]]*aerospace-gaps:[[:space:]]*$1[[:space:]]*=[[:space:]]*\\(.*\\)$/\\1/p" \
    "$CONFIG" | head -n1 | sed 's/[[:space:]]*$//'
}

# Apply directives, then let any environment variable win back.
load_directives() {
  local v
  v=$(directive docked);  [[ -n $v ]] && { DOCKED_TOP=$v;     FROM_TOML+=" docked"; }
  v=$(directive native);  [[ -n $v ]] && { NATIVE_TOP=$v;     FROM_TOML+=" native"; }
  v=$(directive monitor); [[ -n $v ]] && { DOCKED_MONITOR=$v; FROM_TOML+=" monitor"; }
  v=$(directive key);     [[ -n $v ]] && { GAP_KEY=$v;        FROM_TOML+=" key"; }

  [[ -n $ENV_DOCKED  ]] && DOCKED_TOP=$ENV_DOCKED
  [[ -n $ENV_NATIVE  ]] && NATIVE_TOP=$ENV_NATIVE
  [[ -n $ENV_MONITOR ]] && DOCKED_MONITOR=$ENV_MONITOR
  [[ -n $ENV_KEY     ]] && GAP_KEY=$ENV_KEY

  [[ $DOCKED_TOP =~ ^[0-9]+$ ]] || die "docked gap must be a whole number, got '$DOCKED_TOP'"
  [[ $NATIVE_TOP =~ ^[0-9]+$ ]] || die "native gap must be a whole number, got '$NATIVE_TOP'"
  [[ $GAP_KEY =~ ^[A-Za-z0-9._-]+$ ]] || die "gap key must be a TOML key, got '$GAP_KEY'"
  return 0
}

# Escape the gap key for use in a POSIX basic regular expression.
key_re() { printf '%s' "$GAP_KEY" | sed 's/[.[\*^$]/\\&/g'; }

read_top() {
  sed -n "s/^[[:space:]]*$(key_re)[[:space:]]*=[[:space:]]*\([0-9]\{1,\}\).*/\1/p" "$1" | head -n1
}

current_top() { read_top "$CONFIG"; }

monitors() {
  command -v aerospace >/dev/null || die "aerospace not found on PATH"
  aerospace list-monitors --format '%{monitor-name}' \
    || die "could not query monitors — is the AeroSpace app running?"
}

# AeroSpace 0.20 exposes no monitor geometry, so we match on names instead:
# an explicit AEROSPACE_DOCKED_MONITOR regex if set, otherwise any panel that
# is not a recognized built-in one.
detect_mode() {
  local names
  names=$(monitors)
  if [[ -n $DOCKED_MONITOR ]]; then
    if grep -Eiq "$DOCKED_MONITOR" <<<"$names"; then echo docked; else echo native; fi
  elif grep -Eiv "$BUILTIN_MONITOR" <<<"$names" | grep -q '[^[:space:]]'; then
    echo docked
  else
    echo native
  fi
}

set_top() {
  local want=$1 have tmp
  have=$(current_top)
  [[ -n $have ]] || die "no '$GAP_KEY = <number>' line found in $CONFIG"

  if [[ $have == "$want" ]]; then
    echo "$GAP_KEY already $want — nothing to do"
    return 0
  fi

  tmp=$(mktemp "${TMPDIR:-/tmp}/aerospace-gaps.XXXXXX")
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN
  sed "s/^\([[:space:]]*$(key_re)[[:space:]]*=[[:space:]]*\)[0-9]\{1,\}/\1$want/" "$CONFIG" >"$tmp"
  [[ $(read_top "$tmp") == "$want" ]] || die "rewrite produced no change; $CONFIG left untouched"
  # Copy contents rather than mv, to preserve the file's inode and permissions.
  cat "$tmp" >"$CONFIG"

  if [[ -z ${AEROSPACE_GAPS_NO_RELOAD:-} ]]; then
    aerospace reload-config
    echo "$GAP_KEY $have -> $want (config reloaded)"
  else
    echo "$GAP_KEY $have -> $want"
  fi
}

case "${1:-auto}" in
  -v|--version|-h|--help|help) ;;  # these need no config
  *) [[ -f $CONFIG ]] || die "no AeroSpace config at $CONFIG"
     load_directives ;;
esac

case "${1:-auto}" in
  auto)
    mode=$(detect_mode)
    echo "detected: $mode"
    if [[ $mode == docked ]]; then set_top "$DOCKED_TOP"; else set_top "$NATIVE_TOP"; fi ;;
  docked) set_top "$DOCKED_TOP" ;;
  native) set_top "$NATIVE_TOP" ;;
  toggle)
    if [[ $(current_top) == "$DOCKED_TOP" ]]; then set_top "$NATIVE_TOP"; else set_top "$DOCKED_TOP"; fi ;;
  status)
    printf 'config:    %s\n' "$CONFIG"
    printf '%-10s %s (docked=%s native=%s)\n' "$GAP_KEY:" "$(current_top)" "$DOCKED_TOP" "$NATIVE_TOP"
    printf 'monitors:  %s\n' "$(monitors | paste -sd, -)"
    printf 'detected:  %s\n' "$(detect_mode)"
    [[ -n $FROM_TOML ]] && printf 'from toml:%s\n' "$FROM_TOML"
    [[ -n $DOCKED_MONITOR ]] && printf 'monitor:   %s\n' "$DOCKED_MONITOR"
    true ;;
  -v|--version) echo "aerospace-gaps $VERSION" ;;
  -h|--help|help) sed -n '2,25p' "$0" | sed 's/^#\{1,\} \{0,1\}//' ;;
  *) die "unknown command '$1' (try: auto, docked, native, toggle, status)" ;;
esac
