# Optional. Prefer putting gap values in your aerospace.toml as directives:
#
#   # aerospace-gaps: docked  = 40
#   # aerospace-gaps: native  = 10
#   # aerospace-gaps: monitor = ultragear|dell u2720q
#   # aerospace-gaps: key     = outer.top
#
# Those outrank this file. Copy this to ~/.config/aerospace-gaps/config only
# if you need settings that cannot live inside aerospace.toml itself, such as
# where aerospace.toml is. Sourced as shell; environment variables win over it.

# Where your AeroSpace config lives.
#AEROSPACE_CONFIG="$HOME/dotfiles/aerospace.toml"

# Fallbacks, used when aerospace.toml declares no directives.
#AEROSPACE_GAP_DOCKED=40
#AEROSPACE_GAP_NATIVE=10
#AEROSPACE_GAP_KEY=outer.top
#AEROSPACE_DOCKED_MONITOR='ultragear|dell u2720q'
